# Local secrets and credentials
.env
*.pem
*.key

# Ignore PyCache and compiled python
**/__pycache__/**
*.pyc

# ignore all logs
*.log
*.vscode

# ignore all ansible retries
*.retry

# Ignore any included collections
collections/*
!collections/requirements.yml
*.tar.gz

# Ignore Vim working and backup files
.*.swp
*~

# Ignore test directory
test

# Ignore unneeded Ansible related files
/.ansible
.ansible_tmp
/ansible.cfg
/ansible_collections

# Ignore python virtual environment
.venv

# ignore generated documentation
*.html
*.pdf

importer_result.json
.DS_Store
.agents/
